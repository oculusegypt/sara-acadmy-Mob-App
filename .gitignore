# Built-in Android/Gradle ignores
*.iml
.gradle/
/local.properties
/.idea/
.DS_Store
/build
/captures
.externalNativeBuild
.cxx

# Gradle caches & build outputs
**/build/
**/.gradle/
*.lock
*.bin
